# Content Pipeline Configuration
# Copy to .env and customize

# Content directory (default: current directory)
# CONTENT_DIR=./content

# Default to dry-run mode (safe for testing)
# DRY_RUN=true

# pi rewrite settings (optional)
# PI_MODEL=anthropic/claude-opus-4-6
# PI_SKILL=scribe

# Platform credentials are stored encrypted in ~/.content-pipeline/
# Run: content auth <platform>
#   content auth linkedin
#   content auth x
#   content auth reddit
#   content auth devto
#   content auth hashnode
